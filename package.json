{
  "name": "strata",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "check-types": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "node .output/server/index.mjs",
    "release": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate-local.mjs",
    "test": "vitest run",
    "lint": "oxlint --deny-warnings src tests scripts",
    "add-images": "node scripts/add-images.mjs",
    "share-images": "node scripts/render-share-images.mjs",
    "icons": "node scripts/make-icons.mjs",
    "world-map": "node scripts/build-world-map.mjs"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-start": "^1.168.60",
    "clsx": "^2.1.1",
    "drizzle-orm": "1.0.0-rc.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.58.0",
    "@layerwise/vite": "^0.1.11",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "1.0.0-rc.4",
    "opentype.js": "^2.0.0",
    "oxlint": "^1.91.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "8.3.0",
    "vitest": "^5.1.0",
    "wrangler": "4.137.0"
  }
}
